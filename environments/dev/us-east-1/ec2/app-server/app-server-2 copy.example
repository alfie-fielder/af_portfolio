environment    = "dev"
tfstate_bucket = "af-portfolio-tfstate"

instance_type = "t3.large"

root_volume_size = 50
root_volume_type = "gp3"
kms_key_id       = null

ebs_block_devices = [
  {
    device_name           = "/dev/sdb"
    volume_size           = 100
    volume_type           = "gp3"
    delete_on_termination = true
    tags = {
      Name        = "dev-app-server-01-data"
      Role        = "app-server-data"
      Environment = "dev"
      ManagedBy   = "terraform"
      Project     = "af-portfolio"
    }
  }
]

tags = {
  Name        = "dev-app-server-02"
  Role        = "app-server"
  Environment = "dev"
  ManagedBy   = "terraform"
  Project     = "af-portfolio"
}

volume_tags = {
  Name        = "dev-app-server-02-root"
  Role        = "app-server"
  Environment = "dev"
  ManagedBy   = "terraform"
  Project     = "af-portfolio"
}
